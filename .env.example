# ==============================================================================
# Universal Quotation Discord Bot - Environment Configuration Template
# Copy this file to .env and configure values before starting the Discord Gateway.
# Note: NEVER commit real tokens or private secrets into version control.
# ==============================================================================

# Discord Bot Credentials (Obtain from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID_HERE"

# Optional: Guild ID for instant slash command synchronization in development
# If left empty, commands will be deployed globally (takes ~1 hour to propagate globally on Discord)
DISCORD_GUILD_ID=""

# Database Configuration
# Default is SQLite file or in-memory repository. For PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL="sqlite://./data/quotations.db"

# Store Branding & Defaults
DEFAULT_BOT_NAME="Universal Quotation System"
DEFAULT_ACCENT_COLOR="#5865F2"
DEFAULT_CURRENCY="USD"

# Web Server & AI Studio Hosting
PORT=3000
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
